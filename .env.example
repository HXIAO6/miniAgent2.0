# 复制为 .env 后填写；不要把真实密钥提交到 GitHub。
OPENAI_API_KEY=your_model_api_key
OPENAI_BASE_URL=https://your-openai-compatible-provider.example/v1
CHAT_MODEL=deepseek-flash
SUMMARY_MODEL=deepseek-flash

# 模型调用后端：langchain（新）或 openai-agents（兼容旧实现）
CHAT_BACKEND=langchain
MODEL_TIMEOUT=60
MODEL_MAX_RETRIES=1
AGENT_TOOL_LIMIT=3
AGENT_RECURSION_LIMIT=16

# 本地 Ollama embedding
OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_EMBED_MODEL=bge-m3:latest
RAG_RERANK_MODEL_DIR=./models/bge-reranker-base

# 可选：联网搜索
TAVILY_API_KEY=

# 可选运行参数
APP_HOST=127.0.0.1
APP_PORT=7860
# 新 React/FastAPI 主界面端口；APP_PORT 留给迁移期间的 Gradio。
API_PORT=8000
WEB_MEMORY_DB_PATH=./data/web_chat.sqlite3
LOG_LEVEL=INFO
STRICT_KNOWLEDGE_DEFAULT=true
# 仅服务端可配置，修改策略后重启；文件写入未开放。
SECURITY_POLICY_PATH=./configs/security.json
TOOL_WORKSPACE=./tool_workspace
# 本地仅保存统计；远程导出必须显式开启并运行导出命令。
MINIAGENT_TRACE_ENABLED=true
MINIAGENT_TRACE_DIR=./data/traces
MINIAGENT_AUDIT_ENABLED=true
MINIAGENT_AUDIT_DIR=./data/audit
MINIAGENT_LANGSMITH_EXPORT=false
MINIAGENT_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# 短期记忆 SQLite 路径（相对路径以项目根目录为基准）
MEMORY_DB_PATH=./data/memory.sqlite3
